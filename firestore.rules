rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alpha.3 rules are for the local emulator only. Authentication is mandatory.
    match /{collection}/{document} {
      allow read, write: if request.auth != null
        && collection in ['clients', 'operators', 'teams', 'vehicles', 'interventions', 'reports', 'messages'];
    }
    match /{document=**} { allow read, write: if false; }
  }
}
