rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function isOffice() { return signedIn() && profile().role == 'office'; }
    function isOperator() { return signedIn() && profile().role == 'operator' && profile().active != false; }
    function operatorId() { return profile().operatorId; }
    function assigned(data) {
      return isOperator() && (
        data.operatorId == operatorId() ||
        (data.assignedOperatorIds is list && operatorId() in data.assignedOperatorIds) ||
        (data.teamId != null && get(/databases/$(database)/documents/teams/$(data.teamId)).data.operatorIds.hasAny([operatorId()]))
      );
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOffice());
      allow create, update, delete: if isOffice();
    }
    match /operators/{id} {
      allow read: if isOffice() || (isOperator() && id == operatorId());
      allow write: if isOffice();
    }
    match /teams/{id} {
      allow read: if isOffice() || (isOperator() && resource.data.operatorIds.hasAny([operatorId()]));
      allow write: if isOffice();
    }
    match /clients/{id} { allow read, write: if isOffice(); }
    match /vehicles/{id} {
      allow read: if signedIn();
      allow write: if isOffice();
    }
    match /interventions/{id} {
      allow read: if isOffice() || assigned(resource.data);
      allow create, delete: if isOffice();
      allow update: if isOffice() || (assigned(resource.data) && assigned(request.resource.data));
    }
    match /reports/{id} {
      allow read: if isOffice() || (isOperator() && assigned(get(/databases/$(database)/documents/interventions/$(id)).data));
      allow create, update: if isOffice() || (isOperator() && assigned(get(/databases/$(database)/documents/interventions/$(id)).data));
      allow delete: if isOffice();
    }
    match /messages/{id} {
      allow read: if isOffice() || (isOperator() && resource.data.operatorId == operatorId());
      allow create: if isOffice() || (isOperator() && request.resource.data.operatorId == operatorId());
      allow update: if isOffice() || (isOperator() && resource.data.operatorId == operatorId() && request.resource.data.operatorId == operatorId());
      allow delete: if isOffice();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
