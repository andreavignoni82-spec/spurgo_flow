rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    function isOffice() { return signedIn() && profile().role == 'office'; }
    function isOperator() { return signedIn() && profile().role == 'operator'; }
    function operatorId() { return profile().operatorId; }

    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOffice());
      allow create, update, delete: if isOffice();
    }

    match /operators/{id} {
      allow read: if isOffice() || (isOperator() && id == operatorId());
      allow write: if isOffice();
    }

    match /teams/{id} {
      allow read, write: if isOffice();
    }
    match /clients/{id} {
      allow read, write: if isOffice();
    }
    match /vehicles/{id} {
      allow read, write: if isOffice();
    }
    match /resourceAvailability/{id} {
      allow read, write: if isOffice();
    }

    match /interventions/{id} {
      allow read: if isOffice() || (isOperator() && resource.data.operatorId == operatorId());
      allow create: if isOffice() || (isOperator() && request.resource.data.operatorId == operatorId());
      allow update: if isOffice() || (
        isOperator() &&
        resource.data.operatorId == operatorId() &&
        request.resource.data.operatorId == operatorId()
      );
      allow delete: if isOffice();
    }

    match /messages/{id} {
      allow read: if isOffice() || (isOperator() && resource.data.operatorId == operatorId());
      allow create: if isOffice() || (isOperator() && request.resource.data.operatorId == operatorId());
      allow update: if isOffice() || (
        isOperator() &&
        resource.data.operatorId == operatorId() &&
        request.resource.data.operatorId == operatorId()
      );
      allow delete: if isOffice();
    }
  }
}